# ─────────────────────────────────────────────
# pic.dress 환경변수 예시
# Vercel > Project > Settings > Environment Variables 에 그대로 넣으면 돼요.
# ─────────────────────────────────────────────

# 사이트 주소 (결제 후 돌아올 주소, 메일 링크에 쓰여요)
SITE_URL=https://picdress.vercel.app

# DB (Supabase > Project Settings > Database > Connection string > "Transaction pooler")
DATABASE_URL=postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# ── 영업 일정 ──
OPEN_START=2026-11-02
OPEN_END=2026-11-13
# 쉬는 날이 있으면 쉼표로: 2026-11-08,2026-11-09
CLOSED_DATES=
SLOT_START=11:00
SLOT_END=18:00
SLOT_INTERVAL_MINUTES=30
SLOT_CAPACITY=4
# 시작 몇 분 전까지 예약/취소 가능
BOOKING_CUTOFF_MINUTES=30
# 드레스 대여 시간 + 반납 후 정리 시간 (같은 드레스 겹침 계산용)
RENTAL_MINUTES=120
DRESS_BUFFER_MINUTES=0

# ── 결제 ──
# manual(기본) = 사업자 없이: 아래 송금 링크로 받고 관리자 화면에서 '결제 확인'
# online       = 사업자 등록 후 포트원 자동 결제 (아래 PORTONE_* 필요)
PAYMENT_MODE=manual

# [manual] 값을 넣은 결제수단만 결제 화면에 보여요
# 토스 앱 → 전체 → 토스아이디 → 링크 복사 (예: https://toss.me/picdress)
TOSS_SEND_LINK=
# 카카오페이 앱 → 송금 → 송금코드 → 링크 복사 (예: https://qr.kakaopay.com/xxxx)
KAKAOPAY_SEND_LINK=
# PayPal.Me 링크 (예: https://paypal.me/picdress) — 달러 금액이 자동으로 붙어요
PAYPAL_LINK=
# (선택) 계좌이체로도 받으려면: 국민은행 000-0000-0000 (예금주 홍길동)
BANK_ACCOUNT=
# (선택) 1이면 '현장 결제(현금)' 선택지 표시
ONSITE_PAYMENT=
# 신청 후 몇 시간 안에 송금해야 하는지
DEPOSIT_HOURS=2
# 드레스에 달러 가격이 없을 때 PayPal 금액 계산용 (1달러 = 몇 원, 올림)
KRW_PER_USD=1400
# 결제 화면에서 자리 잡아두는 시간(분)
HOLD_MINUTES=10

# [online] 포트원 콘솔 → 결제 연동
PORTONE_STORE_ID=
PORTONE_API_SECRET=
PORTONE_CHANNEL_KR=
PORTONE_CHANNEL_GLOBAL=
PORTONE_WEBHOOK_SECRET=
GLOBAL_CURRENCY=KRW

# 로컬 테스트용 모의결제. 실제 서버에서는 절대 1로 두지 마세요!
PAYMENT_MOCK=

# 환불 규정 "이용일까지 남은 일수:환불%" (큰 것부터 적용)
# 예) 3일 전까지 100%, 1일 전까지 50%, 당일 0%
REFUND_RULES=3:100,1:50,0:0

# ── 관리자 ──
ADMIN_PASSWORD=관리자비밀번호를_길게
# 아무 랜덤 문자열 32자 이상 (로그인 유지용)
SESSION_SECRET=여기에_랜덤한_긴_문자열

# ── 메일 (Gmail 2단계 인증 → 앱 비밀번호 발급) ──
GMAIL_USER=picdress012@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_NAME=pic.dress
# 새 예약/취소 알림 받을 관리자 메일
ADMIN_NOTIFY_EMAIL=picdress012@gmail.com

# ── 사이트 하단 사업자 정보 (PG 심사 때 필요) ──
BUSINESS_NAME=
BUSINESS_OWNER=
BUSINESS_REG_NO=
BUSINESS_MAIL_ORDER_NO=
BUSINESS_ADDRESS=서울 서대문구 대현동 60-11 2층
BUSINESS_PHONE=010-9618-0879
BUSINESS_EMAIL=picdress012@gmail.com
